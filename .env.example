# ═══════════════════════════════════════════════════════════════════
# PDF RAG Application — Environment Variables
# Copy this file to .env and adjust as needed.
# ═══════════════════════════════════════════════════════════════════

# ── Paths ────────────────────────────────────────────────────────
# DATA_DIR=./data

# ── Upload ───────────────────────────────────────────────────────
# MAX_FILE_SIZE_MB=50

# ── Chunking ─────────────────────────────────────────────────────
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# ── Embedding ────────────────────────────────────────────────────
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_BATCH_SIZE=64

# ── OCR ──────────────────────────────────────────────────────────
# OCR_ENABLED=true
# OCR_LANGUAGE=eng

# ── LLM: Google Gemini through its OpenAI-compatible endpoint ────
# Put your own key in .env only. Never commit it.
# OPENAI_API_KEY=your-gemini-api-key
# OPENAI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=a Gemini model name from Google AI Studio, e.g. gemini-2.5-flash

# ── Dual-State tutoring ──────────────────────────────────────────
# TOP_K_RETRIEVAL=5
# PARTIAL_LIMIT=0.50
# STRONG_LIMIT=0.75

# ── Accounts ─────────────────────────────────────────────────────
# The administrator account is created on the first start from these.
# Use your own password and keep it only in .env.
# ADMIN_NAME=Administrator
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-strong-password
# TOKEN_IDLE_MINUTES=30

# ── Server ───────────────────────────────────────────────────────
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ORIGINS=["*"]
# LOG_LEVEL=INFO
